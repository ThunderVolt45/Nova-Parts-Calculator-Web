{
  "name": "nova-parts-calculator-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "catalog:import": "node scripts/import-reference-catalog.mjs",
    "gx:mapping": "python scripts/generate-gx-resource-map.py",
    "gx:inspect": "node --experimental-strip-types scripts/inspect-gx-parser.mjs",
    "gx:assembly": "node --experimental-strip-types scripts/inspect-unit-sockets.mjs",
    "gx:convert": "node --experimental-strip-types scripts/convert-gx-glb.mjs",
    "calculation:golden": "python scripts/generate-calculation-golden.py",
    "calculation:golden:final": "python scripts/generate-final-calculation-golden.py",
    "calculation:golden:validation": "python scripts/generate-validation-golden.py",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
